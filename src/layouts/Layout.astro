---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Cursor from '../components/Cursor';
import Header from '../components/Header';
import ContactButton from '../components/ContactButton';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = (Astro.currentLocale ?? 'ru') as Locale;
const dict = getDictionary(locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Cursor client:load transition:persist transition:name="cursor" />
    <Header dict={dict} locale={locale} client:load transition:persist transition:name="header" />
    <ContactButton dict={dict} client:load transition:persist transition:name="contact-button" />
    <div class="pt-16 md:pt-20">
      <slot />
    </div>
  </body>
</html>
