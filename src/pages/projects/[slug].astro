---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { platformLabels } from '../../data/directions';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\/index$/, '') },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Данил Ефремов`}>
  <article class="container-site py-20 md:py-28">
    <a href="/#projects" data-cursor="link" class="text-sm font-medium text-fg-muted transition-colors hover:text-fg">
      ← Проекты
    </a>

    <header class="mt-6">
      <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">{project.data.title}</h1>
      <p class="mt-3 text-fg-muted">{project.data.company} · {project.data.period}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.platforms.map((platform) => (
          <li class="glass-panel rounded-full px-3 py-1 text-xs font-medium text-fg-muted">
            {platformLabels[platform]}
          </li>
        ))}
      </ul>
    </header>

    <div class="glass-panel mt-10 overflow-hidden rounded-[24px]">
      <Image src={project.data.cover} alt={project.data.title} width={1600} height={1200} class="w-full object-cover" />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="prose-project max-w-[70ch]">
        <Content />
      </div>
    </div>

    {project.data.gallery.length > 0 && (
      <div class="mt-16 flex flex-col gap-6">
        {project.data.gallery.map((image) => (
          <div class="glass-panel overflow-hidden rounded-[20px]">
            <Image src={image} alt={project.data.title} width={1600} height={1200} class="w-full object-cover" />
          </div>
        ))}
      </div>
    )}
  </article>
</Layout>
