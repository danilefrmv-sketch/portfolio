---
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { platformLabels, sphereLabels } from '../../data/directions';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  return projects.map((project, i) => {
    const prevProject = projects[(i - 1 + projects.length) % projects.length];
    const nextProject = projects[(i + 1) % projects.length];
    return {
      params: { slug: project.id.replace(/\/index$/, '') },
      props: { project, prevProject, nextProject }
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
const showNeighborNav = prevProject.id !== project.id;
const slugOf = (p: typeof project) => p.id.replace(/\/index$/, '');

const allImages = [project.data.cover, ...project.data.gallery];
const carouselImages = await Promise.all(
  allImages.map(async (image) => {
    const optimized = await getImage({ src: image });
    return { src: optimized.src, width: optimized.attributes.width, height: optimized.attributes.height };
  })
);
---

<Layout title={`${project.data.title} — Данил Ефремов`}>
  <article class="container-site pb-24 pt-10 md:pt-14">
    <a
      href={withBase('#projects')}
      data-cursor="link"
      class="glass-panel inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:text-accent"
      aria-label="Назад к проектам"
    >
      <svg viewBox="0 0 256 256" width="18" height="18" fill="currentColor">
        <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
      </svg>
    </a>

    <header class="mt-6">
      <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">{project.data.title}</h1>
      <p class="mt-3 text-fg-muted">{sphereLabels[project.data.direction]} · {project.data.period}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.platforms.map((platform) => (
          <li class="glass-panel rounded-full px-3 py-1 text-xs font-medium text-fg-muted">
            {platformLabels[platform]}
          </li>
        ))}
      </ul>
    </header>

    <div class="mt-10" transition:name={`cover-${project.id}`}>
      <Carousel images={carouselImages} alt={project.data.title} client:visible />
    </div>

    <div class="prose-project mt-12 max-w-4xl columns-1 gap-12 md:columns-2">
      <Content />
    </div>

    {showNeighborNav && (
      <nav aria-label="Другие кейсы" class="mt-20 grid grid-cols-1 gap-3 border-t border-border pt-10 md:grid-cols-2 md:gap-6">
        <a
          href={withBase(`projects/${slugOf(prevProject)}/`)}
          data-cursor="view"
          class="group flex items-center gap-4 rounded-[20px] p-3 transition-colors hover:bg-white/5"
        >
          <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-2xl">
            <Image src={prevProject.data.cover} alt="" width={128} height={128} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="min-w-0">
            <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-fg-muted">
              <svg viewBox="0 0 256 256" width="12" height="12" fill="currentColor">
                <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
              </svg>
              Предыдущий кейс
            </p>
            <p class="mt-1 truncate font-display text-lg font-semibold">{prevProject.data.title}</p>
          </div>
        </a>

        <a
          href={withBase(`projects/${slugOf(nextProject)}/`)}
          data-cursor="view"
          class="group flex items-center gap-4 rounded-[20px] p-3 text-right transition-colors hover:bg-white/5 md:flex-row-reverse"
        >
          <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-2xl">
            <Image src={nextProject.data.cover} alt="" width={128} height={128} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="min-w-0">
            <p class="flex items-center justify-end gap-1.5 text-xs font-medium uppercase tracking-wide text-fg-muted">
              Следующий кейс
              <svg viewBox="0 0 256 256" width="12" height="12" fill="currentColor">
                <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z" />
              </svg>
            </p>
            <p class="mt-1 truncate font-display text-lg font-semibold">{nextProject.data.title}</p>
          </div>
        </a>
      </nav>
    )}
  </article>
</Layout>
