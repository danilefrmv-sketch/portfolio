---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { platformLabels } from '../../data/directions';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\/index$/, '') },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Данил Ефремов`}>
  <article class="container-site pb-24 pt-10 md:pt-14">
    <a
      href="/#projects"
      data-cursor="link"
      class="glass-panel inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:text-accent"
      aria-label="Назад к проектам"
    >
      <svg viewBox="0 0 256 256" width="18" height="18" fill="currentColor">
        <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
      </svg>
    </a>

    <header class="mt-6">
      <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">{project.data.title}</h1>
      <p class="mt-3 text-fg-muted">{project.data.company} · {project.data.period}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.platforms.map((platform) => (
          <li class="glass-panel rounded-full px-3 py-1 text-xs font-medium text-fg-muted">
            {platformLabels[platform]}
          </li>
        ))}
      </ul>
    </header>

    <div
      class="glass-panel mx-auto mt-10 max-w-4xl overflow-hidden rounded-[24px]"
      transition:name={`cover-${project.id}`}
    >
      <Image src={project.data.cover} alt={project.data.title} class="h-auto w-full" />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="prose-project max-w-[70ch]">
        <Content />
      </div>
    </div>

    {project.data.gallery.length > 0 && (
      <div class="mt-16 flex flex-col gap-10">
        {project.data.gallery.map((image) => (
          <div class="glass-panel mx-auto max-w-4xl overflow-hidden rounded-[20px]">
            <Image src={image} alt={project.data.title} class="h-auto w-full" />
          </div>
        ))}
      </div>
    )}
  </article>
</Layout>
