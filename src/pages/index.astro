---
import Layout from '../layouts/Layout.astro';
import StatusClock from '../components/StatusClock';
import ProjectFilter from '../components/ProjectFilter';
import ContactMenuButton from '../components/ContactMenuButton';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import danilPhoto from '../assets/images/danil.jpg';
import { getDictionary, type Locale } from '../i18n';
import { platformLabels } from '../data/directions';

const locale = (Astro.currentLocale ?? 'ru') as Locale;
const dict = getDictionary(locale);

const allProjects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const presentPlatforms = [...new Set(allProjects.flatMap((p) => p.data.platforms))].map((value) => ({
  value,
  label: platformLabels[value]
}));
---

<Layout title="Данил Ефремов — UX/UI дизайнер">
  <main id="hero" class="container-site pb-10 pt-10 md:pt-14">
    <div class="grid-16 w-full items-center">
      <div class="col-span-full md:col-span-[9]">
        <StatusClock available availableLabel={dict.hero.available} busyLabel={dict.hero.busy} client:load />

        <h1 class="mt-8 font-display text-3xl font-semibold leading-[1.3] tracking-tight md:text-4xl">
          <span class="flex flex-wrap items-center gap-3">
            {dict.hero.greetingLead}
            <span class="border-bg ring-fg/10 shadow-[0_10px_24px_-6px_rgba(0,0,0,0.7)] inline-flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-[3px] ring-1 md:h-20 md:w-20">
              <Image src={danilPhoto} alt="Данил Ефремов" width={160} height={160} class="h-full w-full object-cover" />
            </span>
            {dict.hero.greetingName}
          </span>
          <span class="block">{dict.hero.greetingRole}</span>
        </h1>

        <div class="mt-8">
          <ContactMenuButton dict={dict} dropdownPosition="below" align="left" client:load />
        </div>
      </div>

      <div class="col-span-full mt-10 self-start md:col-span-[7] md:mt-0">
        <p class="max-w-[48ch] text-base text-fg-muted md:text-lg">
          {dict.hero.subtext}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2">
          {dict.hero.domains.map((domain) => (
            <li class="glass-panel rounded-full px-3 py-1 text-xs font-medium text-fg-muted">{domain}</li>
          ))}
        </ul>
      </div>
    </div>
  </main>

  <section id="projects" class="container-site pb-20 pt-10 md:pb-28 md:pt-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">{dict.nav.projects}</h2>
      {presentPlatforms.length > 1 && (
        <ProjectFilter platforms={presentPlatforms} allLabel={dict.projects.all} client:load />
      )}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {allProjects.map((project) => (
        <a
          href={`/projects/${project.id.replace(/\/index$/, '')}/`}
          data-cursor="view"
          data-project-card
          data-platforms={project.data.platforms.join(',')}
          class="group block"
        >
          <div
            class="glass-panel relative aspect-[4/3] overflow-hidden rounded-[20px]"
            transition:name={`cover-${project.id}`}
          >
            <Image
              src={project.data.cover}
              alt={project.data.title}
              width={640}
              height={480}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-bg/0 transition-colors duration-300 group-hover:bg-bg/30" />
            <ul class="absolute left-3 top-3 flex flex-wrap gap-1.5">
              {project.data.platforms.map((platform) => (
                <li class="rounded-full bg-bg/70 px-2.5 py-0.5 text-sm font-medium text-fg backdrop-blur-md">
                  {platformLabels[platform]}
                </li>
              ))}
            </ul>
          </div>
          <h4 class="mt-4 font-display text-lg font-semibold">{project.data.title}</h4>
          <p class="mt-1 text-sm text-fg-muted">{project.data.company} · {project.data.period}</p>
          <p class="mt-2 text-sm text-fg-muted">{project.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <script>
    const SCROLL_KEY = 'projectsScrollY';

    if (!(window as typeof window & { __scrollRestoreInit?: boolean }).__scrollRestoreInit) {
      (window as typeof window & { __scrollRestoreInit?: boolean }).__scrollRestoreInit = true;

      document.addEventListener('click', (event) => {
        const card = (event.target as HTMLElement).closest('[data-project-card]');
        if (card) sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
      });

      const restoreScroll = () => {
        // Only relevant on the catalog/home page (the only page with #projects).
        if (!document.getElementById('projects')) return;
        const saved = sessionStorage.getItem(SCROLL_KEY);
        if (saved === null) return;
        sessionStorage.removeItem(SCROLL_KEY);
        requestAnimationFrame(() => window.scrollTo({ top: Number(saved), behavior: 'instant' }));
      };

      restoreScroll();
      document.addEventListener('astro:page-load', restoreScroll);
    }
  </script>
</Layout>
