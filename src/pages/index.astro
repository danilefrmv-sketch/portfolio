---
import Layout from '../layouts/Layout.astro';
import StatusClock from '../components/StatusClock';
import { Image } from 'astro:assets';
import danilPhoto from '../assets/images/danil.jpg';
import { getDictionary, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'ru') as Locale;
const dict = getDictionary(locale);
---

<Layout title="Данил Ефремов — UX/UI дизайнер">
  <main class="container-site flex min-h-[100dvh] items-center py-24">
    <div class="grid-16 w-full items-center">
      <div class="col-span-full md:col-span-[9]">
        <StatusClock available availableLabel={dict.hero.available} busyLabel={dict.hero.busy} client:load />
        <h1 class="mt-8 font-display text-4xl font-semibold leading-[1.15] tracking-tight md:text-5xl">
          {dict.hero.greeting} {dict.hero.role}
        </h1>
        <p class="mt-6 max-w-[52ch] text-lg text-fg-muted">
          {dict.hero.subtext}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#projects" data-cursor="link" class="rounded-full bg-accent px-6 py-3 font-medium text-bg">
            {dict.hero.ctaProjects}
          </a>
          <a href="#contact" data-cursor="link" class="glass-panel rounded-full px-6 py-3 font-medium">
            {dict.hero.ctaContact}
          </a>
        </div>
      </div>
      <div class="col-span-full mt-12 md:col-span-[7] md:mt-0">
        <div class="glass-panel mx-auto max-w-sm overflow-hidden rounded-[24px] md:max-w-none">
          <Image src={danilPhoto} alt="Данил Ефремов" width={640} height={640} class="aspect-square w-full object-cover" />
        </div>
      </div>
    </div>
  </main>
</Layout>
