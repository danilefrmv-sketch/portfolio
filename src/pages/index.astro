---
import Layout from '../layouts/Layout.astro';
import StatusClock from '../components/StatusClock';
import { Image } from 'astro:assets';
import danilPhoto from '../assets/images/danil.jpg';
import { getDictionary, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'ru') as Locale;
const dict = getDictionary(locale);
---

<Layout title="Данил Ефремов — UX/UI дизайнер">
  <main id="hero" class="container-site flex min-h-[100dvh] items-center py-24">
    <div class="grid-16 w-full items-center">
      <div class="col-span-full md:col-span-[10]">
        <StatusClock available availableLabel={dict.hero.available} busyLabel={dict.hero.busy} client:load />

        <h1 class="mt-8 font-display text-2xl font-semibold leading-[1.3] tracking-tight md:text-3xl lg:text-4xl">
          {dict.hero.greetingLead}{' '}
          <span class="border-bg ring-fg/10 shadow-[0_10px_24px_-6px_rgba(0,0,0,0.7)] inline-flex h-11 w-11 -translate-y-0.5 items-center justify-center overflow-hidden rounded-full border-[3px] ring-1 align-middle md:h-14 md:w-14">
            <Image src={danilPhoto} alt="Данил Ефремов" width={112} height={112} class="h-full w-full object-cover" />
          </span>{' '}
          {dict.hero.greetingTail}
        </h1>

        <div class="mt-8">
          <a href="#contact" data-cursor="link" class="inline-block rounded-full bg-accent px-6 py-3 font-medium text-bg">
            {dict.hero.ctaContact}
          </a>
        </div>
      </div>

      <div class="col-span-full mt-10 md:col-span-[6] md:mt-0">
        <p class="max-w-[38ch] text-fg-muted">
          {dict.hero.subtext}
        </p>
      </div>
    </div>
  </main>
</Layout>
