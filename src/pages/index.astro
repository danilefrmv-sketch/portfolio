---
import Layout from '../layouts/Layout.astro';
import StatusClock from '../components/StatusClock';
import Reveal from '../components/Reveal';
import { Image } from 'astro:assets';
import danilPhoto from '../assets/images/danil.jpg';
import { getDictionary, type Locale } from '../i18n';
import { skillGroups } from '../data/skills';

const locale = (Astro.currentLocale ?? 'ru') as Locale;
const dict = getDictionary(locale);
---

<Layout title="Данил Ефремов — UX/UI дизайнер">
  <main id="hero" class="container-site pb-24 pt-10 md:pt-14">
    <div class="grid-16 w-full items-center">
      <div class="col-span-full md:col-span-[11]">
        <StatusClock available availableLabel={dict.hero.available} busyLabel={dict.hero.busy} client:load />

        <h1 class="mt-8 font-display text-3xl font-semibold leading-[1.3] tracking-tight md:text-4xl lg:text-5xl">
          <span class="flex flex-wrap items-center gap-3">
            {dict.hero.greetingLead}
            <span class="border-bg ring-fg/10 shadow-[0_10px_24px_-6px_rgba(0,0,0,0.7)] inline-flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-[3px] ring-1 md:h-20 md:w-20">
              <Image src={danilPhoto} alt="Данил Ефремов" width={160} height={160} class="h-full w-full object-cover" />
            </span>
            {dict.hero.greetingName}
          </span>
          <span class="block">{dict.hero.greetingRole}</span>
        </h1>

        <div class="mt-8">
          <a href="#contact" data-cursor="link" class="inline-block rounded-full bg-accent px-6 py-3 font-medium text-bg">
            {dict.hero.ctaContact}
          </a>
        </div>
      </div>

      <div class="col-span-full mt-10 self-start md:col-span-[5] md:mt-0">
        <p class="max-w-[40ch] text-base text-fg-muted md:text-lg">
          {dict.hero.subtext}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2">
          {dict.hero.domains.map((domain) => (
            <li class="glass-panel rounded-full px-3 py-1 text-xs font-medium text-fg-muted">{domain}</li>
          ))}
        </ul>
      </div>
    </div>
  </main>

  <section id="about" class="container-site py-20 md:py-28">
    <Reveal client:visible>
      <p class="max-w-[34ch] font-display text-2xl font-medium leading-snug md:max-w-[42ch] md:text-3xl">
        {dict.about.body}
      </p>
    </Reveal>

    <div class="mt-14 flex flex-col gap-6">
      {skillGroups.map((group, i) => (
        <Reveal client:visible delay={0.05 * i}>
          <div class="flex flex-col gap-3 border-t border-border pt-6 md:flex-row md:items-baseline md:gap-8">
            <span class="w-full shrink-0 text-sm text-fg-muted md:w-40">{group.title}</span>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="glass-panel rounded-full px-3 py-1.5 text-xs font-medium text-fg-muted">{item}</li>
              ))}
            </ul>
          </div>
        </Reveal>
      ))}
    </div>
  </section>
</Layout>
